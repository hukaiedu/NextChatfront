[Unit]
Description=PersonChat frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=personchat-front
Group=personchat-front
WorkingDirectory=/opt/personchat-front/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/personchat-front.env
ExecStart=/opt/personchat-front/current/runtime/node /opt/personchat-front/current/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0027
CacheDirectory=personchat-front
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/personchat-front

[Install]
WantedBy=multi-user.target
