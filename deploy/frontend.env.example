# Keep the actual file only at /etc/personchat-front.env, never in Git or release artifacts.
# Production public API traffic uses Nginx /backend-api/ -> Backend directly
# (see deploy/nginx/personchat.conf.example) and does not read this variable.
# BACKEND_ORIGIN is read by the Next runtime proxy used for local/direct-port
# access and for the deployment loopback health check.
# A server on the same host can use loopback.
BACKEND_ORIGIN=http://127.0.0.1:3010